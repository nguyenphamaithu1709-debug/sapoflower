# File mẫu cấu hình biến môi trường Bibi Flower
# Sao chép file này thành .env và điền thông tin thật của bạn:
#   cp .env.example .env

PORT=5000
FLASK_DEBUG=0
DB_PATH=brain.db

# Resend Email API (lấy tại https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_NAME=Bibi Flower
SENDER_EMAIL=hi@soapflower.io.vn

# Đồng bộ đơn hàng Google Apps Script & SePay
SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
SYNC_TOKEN=YOUR_SECRET_SYNC_TOKEN
SYNC_INTERVAL_SECONDS=4
